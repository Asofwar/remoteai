# Unified diff context lines can consist of one space; keep patch bytes stable across hosts.
patches/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Preserve the imported source bytes and upstream formatting on every host.
vendor/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
source-lock.json text eol=lf
