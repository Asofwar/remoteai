# Expo 53 uses 2.24.0; Metro resolves this package's react-native source entry.
# Also keep a nonzero pan distance: Android ORs distance with the directional activation threshold,
# so zero steals stationary edge long-presses from native text selection.
diff --git a/src/components/ReanimatedDrawerLayout.tsx b/src/components/ReanimatedDrawerLayout.tsx
--- a/src/components/ReanimatedDrawerLayout.tsx
+++ b/src/components/ReanimatedDrawerLayout.tsx
@@ -500,6 +500,7 @@
     const overlayDismissGesture = useMemo(
       () =>
         Gesture.Tap()
+          .enabled(drawerOpened)
           .maxDistance(25)
           .onEnd(() => {
             if (
@@ -509,5 +510,5 @@
               closeDrawer();
             }
           }),
-      [closeDrawer, isDrawerOpen, drawerLockMode]
+      [closeDrawer, isDrawerOpen, drawerLockMode, drawerOpened]
     );
@@ -527,5 +528,5 @@
         .activeCursor(activeCursor)
         .mouseButton(mouseButton)
         .hitSlop(drawerOpened ? fillHitSlop : edgeHitSlop)
-        .minDistance(drawerOpened ? 100 : 0)
+        .minDistance(100)
