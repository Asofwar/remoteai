{
  "manifest_version": 3,
  "name": "Remote AI 浏览器助手",
  "version": "1.7.0",
  "description": "让 Remote AI 帮你浏览网页、查找信息和操作网站。你可以随时暂停。",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "tabGroups",
    "debugger",
    "scripting",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Remote AI 浏览器助手"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'self' https://codex.onepiper.cloud"
  },
  "icons": {
    "128": "icon.png"
  }
}
